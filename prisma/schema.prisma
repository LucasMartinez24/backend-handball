generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

// --- MODELO JUGADOR ---
model Jugador {
  id              String   @id @default(uuid())
  dni             String   @unique
  nombreCompleto  String
  fechaNacimiento DateTime
  genero          String?
  nacionalidad    String?  @default("Argentina")
  email           String?
  whatsapp        String?
  tutorPhone      String?
  peso            Float?
  altura          Int?
  categoria       String?
  categoriaEspecial String?
  equipo          String?  // A, B o C
  manoHabil       String?  @default("Derecha")
  estado          String   @default("Pendiente")

  fichaMedicaUrl  String?
  autorizacionUrl String?
  fichaJugadorUrl String? 

  clubId          String
  club            Club     @relation(fields: [clubId], references: [id])
  
  eventos         EventoPartido[]
  movimientos     MovimientoJugador[]
  sanciones       Sancion[]
  
  createdAt       DateTime @default(now())
}

// --- MODELO TORNEO ---
model Torneo {
  id                String   @id @default(uuid())
  nombre            String
  categoria         String
  rama              String
  formato           String   
  idaVuelta         Boolean  @default(false)
  estado            String   @default("Upcoming")
  fechaInicio       DateTime
  progreso          Int      @default(0)
  colorClase        String

  // Configuración de formato y estructura deportiva
  temporada         String?  @default("2026")
  sedes             String?  @db.Text
  faseInicial       String?  @default("semifinales")
  tercerPuesto      Boolean? @default(true)
  modalidadLlave    String?  @default("ida_vuelta")
  cantidadGrupos    Int?     @default(2)
  criterioDesempate String?  @default("dif_gol")

  tablaPosiciones   Posicion[]
  partidos          Partido[]
  createdAt         DateTime @default(now())
}

// --- MODELO POSICION ---
// Limpio: Los invitados ahora son Clubes, así que solo necesitamos relación con Club
model Posicion {
  id        String @id @default(uuid())
  puntos    Int    @default(0)
  pj        Int    @default(0)
  pg        Int    @default(0)
  pe        Int    @default(0)
  pp        Int    @default(0)
  gf        Int    @default(0)
  gc        Int    @default(0)
  dg        Int    @default(0)
  grupo     String? @default("General")

  torneoId  String
  torneo    Torneo @relation(fields: [torneoId], references: [id], onDelete: Cascade)

  clubId    String
  club      Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([torneoId, clubId])
}

// --- MODELO CLUB ---
model Club {
  id         String   @id @default(uuid())
  nombre     String
  siglas     String   @unique
  logoUrl    String?
  
  // Opcionales para que los invitados no necesiten login
  username   String?  @unique
  password   String?
  
  // CLAVE: Para identificar visualmente en el frontend
  esInvitado Boolean  @default(false)

  jugadores         Jugador[]
  movimientosOrigen MovimientoJugador[] @relation("ClubOrigenMovimientos")
  movimientosDestino MovimientoJugador[] @relation("ClubDestinoMovimientos")
  tablasPosiciones  Posicion[]
  partidosLocal     Partido[]  @relation("RelacionLocal")
  partidosVisitante Partido[]  @relation("RelacionVisitante")

  tickets           Ticket[]
  sanciones         Sancion[]
  created_at        DateTime @default(now())
}

// --- MODELO PARTIDO ---
// Eliminados los campos "nombreInvitadoLocal/Visitante"
model Partido {
  id               String    @id @default(uuid())
  torneoId         String
  jornada          Int
  fase             String?   @default("Fase Regular")
  grupo            String?
  penalesLocal     Int?      @default(0)
  penalesVisitante Int?      @default(0)
  
  localId          String
  visitanteId      String
  
  fecha            DateTime?
  lugar            String?    @default("Sede a definir")
  estado           String     @default("Programado")
  
  golesLocal       Int        @default(0)
  golesVisitante   Int        @default(0)
  golesLocalHT     Int        @default(0)
  golesVisitanteHT Int        @default(0)
  
  arbitro1         String?
  arbitro2         String?
  cronometrista    String?
  observaciones    String?    @db.Text

  // CAMBIO: Se agregó onDelete: Cascade para evitar el error P2003
  torneo           Torneo    @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  
  local            Club      @relation("RelacionLocal", fields: [localId], references: [id])
  visitante        Club      @relation("RelacionVisitante", fields: [visitanteId], references: [id])
  
  eventos          EventoPartido[]
  @@index([torneoId])
}

// --- MODELO EVENTO PARTIDO ---
model EventoPartido {
  id             String   @id @default(uuid())
  partidoId      String
  jugadorId      String?  // Null si es un invitado manual cargado en el acta
  nombreInvitado String?  // Nombre del jugador si jugadorId es null
  numeroInvitado Int?
  equipoId       String   // ID del club (federado o invitado)
  tipo           String   // GOL, AMARILLA, DOS_MINUTOS, ROJA, AZUL
  periodo        Int      @default(1)
  
  partido        Partido  @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  jugador        Jugador? @relation(fields: [jugadorId], references: [id])
}

// --- SOPORTE (TICKETS) ---
model Ticket {
  id        String    @id @default(uuid())
  asunto    String
  categoria String    @default("General")
  status    String    @default("Abierto")
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id          String       @id @default(uuid())
  text        String       @db.Text
  senderRole  String       
  senderName  String?      
  isInternal  Boolean      @default(false)
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  createdAt   DateTime     @default(now())
}

model Attachment {
  id        String  @id @default(uuid())
  name      String
  url       String
  messageId String
  message   Message @relation(fields: [messageId], references: [id])
}

model MovimientoJugador {
  id             String   @id @default(uuid())
  jugadorId      String
  clubOrigenId   String
  clubDestinoId  String
  tipo           String
  estado         String   @default("Activo")
  duracionMeses  Int?
  fechaInicio    DateTime @default(now())
  fechaFin       DateTime?
  fechaCierre    DateTime?
  observaciones  String?  @db.Text
  createdAt      DateTime @default(now())

  jugador        Jugador  @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  clubOrigen     Club     @relation("ClubOrigenMovimientos", fields: [clubOrigenId], references: [id], onDelete: Cascade)
  clubDestino    Club     @relation("ClubDestinoMovimientos", fields: [clubDestinoId], references: [id], onDelete: Cascade)

  @@index([jugadorId, estado])
  @@index([clubOrigenId])
  @@index([clubDestinoId])
}
// --- MODELO STAFF (Federación) ---
model Staff {
  id        String   @id @default(uuid())
  nombre    String
  username  String   @unique
  password  String
  // Roles específicos: REP_FEDERACION, OFICIAL_MESA, JEFE_ARBITROS
  role      String   
  createdAt DateTime @default(now())
}
model Galeria {
  id        String   @id @default(uuid())
  url       String
  titulo    String?
  categoria String?  @default("General")
  createdAt DateTime @default(now())

  @@index([categoria]) // Acelera el filtrado por categoría
  @@index([createdAt]) // Acelera el ordenamiento por fecha
}

// --- MODELO SANCIÓN / TRIBUNAL DE PENAS ---
model Sancion {
  id          String   @id @default(uuid())
  sancionado  String
  institucion String
  categoria   String
  fallo       String
  cumplidas   Int      @default(0)
  totales     Int      @default(1)
  vigencia    String?  @default("Torneo Apertura 2026")
  expediente  String
  estado      String   @default("grave") // grave | advertencia | provisorio
  motivo      String?  @db.Text

  jugadorId   String?
  jugador     Jugador? @relation(fields: [jugadorId], references: [id], onDelete: SetNull)

  clubId      String?
  club        Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jugadorId])
  @@index([clubId])
}
